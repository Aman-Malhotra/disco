APP_NAME="Disco"
ENVIRONMENT=local

# Host default. docker-compose overrides host with the `postgres` service name.
DATABASE_URL=postgresql+asyncpg://disco:disco@localhost:4003/disco

CORS_ORIGINS=http://localhost:4001,http://localhost:5173

# LLM provider selection: openai | gemini | openrouter
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# Provider credentials (only the selected provider's key is required)
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Agent loop guardrail
AGENT_MAX_STEPS=12

# Dev-only HTTP access log
LOG_HTTP_BODIES=false
LOG_MAX_BODY_BYTES=4096
